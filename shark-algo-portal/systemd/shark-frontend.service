[Unit]
Description=Shark Algo React Dashboard (Port 5000)
After=network.target shark-python.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/shark-algo-portal/frontend
ExecStart=/usr/bin/npx vite preview --host 0.0.0.0 --port 5000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
