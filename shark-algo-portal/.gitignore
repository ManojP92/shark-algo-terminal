# shark-algo-portal — .gitignore
# ─────────────────────────────────────────────────────────────

# Secrets — NEVER commit these
.env
*.env.local

# Dependencies
node_modules/
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Build output
dist/
build/
*.egg-info/

# Database files
data/*.db
data/*.sqlite3
*.db-shm
*.db-wal

# Logs
logs/*.log
*.log

# PM2
.pm2/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
.idea/
*.swp
*.swo
