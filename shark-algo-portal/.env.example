# ─────────────────────────────────────────────────────────────
#  Shark Exchange Algo Portal — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

SHARK_API_KEY=your_shark_api_key_here
SHARK_API_SECRET=your_shark_api_secret_here

# Base URL for the Shark Exchange REST API
SHARK_BASE_URL=https://api.sharkexchange.in

# ── Trading Safety ────────────────────────────────────────────
# DRY_RUN=true  → log orders only, never send to exchange
# DRY_RUN=false → LIVE TRADING — use with extreme caution
DRY_RUN=true

# Set to true only after Phase 6 sign-off
LIVE=false

# ── Risk Parameters ───────────────────────────────────────────
RISK_PER_TRADE_PCT=1          # % of equity risked per trade
MAX_CONCURRENT_POSITIONS=1
MAX_CONSECUTIVE_LOSSES=3      # auto-pause after this many
DAILY_LOSS_LIMIT_PCT=3        # halt trading for rest of UTC day

# ── Trading Pair ──────────────────────────────────────────────
TRADING_PAIR=BTCUSDT

# ── Server ────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────
DB_PATH=./data/trades.db      # SQLite path (dev)
# DB_URL=postgresql://user:pass@localhost:5432/shark_algo  # prod

# ── Telegram Notifications ────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Python Bridge ────────────────────────────────────────────
PYTHON_BRIDGE_PORT=5001       # local HTTP bridge for py→node comms
